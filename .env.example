# ---- Server ----
PORT=4000
NODE_ENV=development

# Required in production. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_SESSION_HOURS=8

# Express trusts X-Forwarded-For only from these proxies ("loopback", an IP/CIDR list, a hop count, or "false").
# On Vercel leave it empty (it then defaults to 1: Vercel's own proxy). On your own server behind nginx use "loopback" or 1.
TRUST_PROXY=

# Only needed if a browser app on another origin calls this API directly (comma separated)
CORS_ORIGINS=

# Public URL of this server, used in the Slack message link to the admin UI
# On Vercel: https://<your backend project's domain>
PUBLIC_BASE_URL=http://localhost:4000

# Redirects plain-http requests to https and sends a long-lived HSTS header. Defaults to "true" when NODE_ENV=production.
# Only set to false if this app genuinely has no TLS anywhere in front of it (not recommended).
# FORCE_HTTPS=true

# ---- TLS: encrypts the Next.js <-> Express hop at the source ----
# Set both to have this server terminate TLS itself, on TLS_PORT, in addition to the plain-http PORT above (which
# stays open for the redirect, and for a reverse proxy that already terminates TLS elsewhere on the same network).
# Point the frontend's BACKEND_URL at https://<this host>:<TLS_PORT> once these are set.
# Local dev: generate a cert trusted by your own machine with mkcert, or a quick self-signed one with:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 365 -subj "/CN=localhost"
# (a self-signed cert will fail Node's/the browser's normal certificate check -- that check is correct and
# shouldn't be disabled; use a cert your machine already trusts, or a real one in production.)
# TLS_CERT_FILE=./cert.pem
# TLS_KEY_FILE=./key.pem
# TLS_CA_FILE=
# TLS_PORT=4443

# ---- First super admin (created only when the users table is empty) ----
# If SUPERADMIN_PASSWORD is empty, a random one is printed once in the console at first start.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=

# ---- Database: Supabase Postgres ----
# Supabase > Project Settings > Database > Connection string. On Vercel use the TRANSACTION POOLER string (port 6543).
# The tables are created automatically on the first request (or run `npm run setup` once yourself).
DATABASE_URL=
# Optional: the Supabase CA certificate (PEM, newlines written as \n) to fully verify the database's TLS certificate.
# DATABASE_CA_CERT=
# Connections per running function instance (keep this small on Vercel).
# DB_POOL_MAX=3
# How long (ms) one running instance caches settings/domains. Saving in the admin clears the saving instance at once.
# SETTINGS_CACHE_MS=5000

# ---- File storage: Supabase Storage ----
# Supabase > Project Settings > API. The service-role key is a SECRET: only ever put it in the backend's environment.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional (sent as the apikey header on direct browser uploads, for projects that insist on it)
# SUPABASE_ANON_KEY=
# Buckets are created automatically: a PRIVATE one for resumes + photos, a PUBLIC one for the logo and background.
# SUPABASE_UPLOADS_BUCKET=resume-uploads
# SUPABASE_MEDIA_BUCKET=portal-media

# Maximum total size of all stored resumes + photos. When it is exceeded the OLDEST applications (with their files) are
# deleted automatically until the total is back under the limit. 0 turns this off.
MAX_STORAGE_MB=300
# Files that were uploaded but never attached to an application are removed after this many minutes.
# PENDING_UPLOAD_MINUTES=120

# Vercel Cron calls /api/cron/maintenance once a day with this secret (Vercel sends it automatically as a Bearer token).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Per-file limits. Files go from the browser straight to Supabase, so the 4.5 MB Vercel request limit does not apply.
# Supabase's free plan caps ANY single file at 50 MB (Storage > Settings), so keep MAX_BG_VIDEO_MB at or below that.
MAX_RESUME_MB=5
# Optional candidate photo on the apply form
MAX_PHOTO_MB=3

# Uploaded logo / background (managed in Admin > Settings). Files here are public; resumes are not.
MAX_LOGO_MB=2
MAX_BG_IMAGE_MB=10
MAX_BG_VIDEO_MB=40

# ---- Human verification ----
# The number of steps (2 or 3) is set in Admin > Settings.
VERIFY_MAX_ATTEMPTS=3
VERIFY_SESSION_MINUTES=15
VERIFY_TOKEN_MINUTES=30
# The copy/paste (stage 3) challenge never expires on its own; an abandoned one is instead cleaned up by age.
COPY_SESSION_MAX_AGE_DAYS=7
# The one-step re-check in the confirm-submit modal, if left unfinished, is cleaned up sooner than that.
CONFIRM_SESSION_MAX_AGE_HOURS=24

# ---- Notifications ----
# Slack and Telegram values below are DEFAULTS. Whatever the super admin saves in Admin > Settings replaces them.
# Webhook hosts that are accepted (comma separated):
# SLACK_ALLOWED_HOSTS=hooks.slack.com,hooks.slack-gov.com

# ---- Slack (Incoming Webhook URL: https://api.slack.com/messaging/webhooks) ----
SLACK_WEBHOOK_URL=

# ---- Telegram (create a bot with @BotFather, then message it / add it to a group and get the chat id) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Also send the resume file itself to Telegram
TELEGRAM_SEND_FILE=true

# ---- Multi-domain (one backend, many candidate sites) -------------------------------------------------------------
# Add the domains under Admin > Domains. Each can have its own logo, background, theme, verification steps, time zone and
# Slack / Telegram channels; anything it doesn't set comes from the default settings.
#
# The frontend tells the backend which domain a visitor is on (X-Site-Host). Set the SAME secret here and in the
# frontend's .env.local (SITE_PROXY_KEY) so the backend only believes that header when it comes from your frontend.
# Without it, any visitor could claim to be another domain. Leave empty for local development.
SITE_PROXY_KEY=
# true = a request from a host that is not listed under Domains is refused. Default: it gets the default settings.
REQUIRE_KNOWN_DOMAIN=false
